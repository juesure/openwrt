/dts-v1/;
#include "ipq8072.dtsi"
#include "ipq8072-hk-adc.dtsi"

/ {
	model = "Xiaomi AX3600";
	compatible = "xiaomi,ax3600", "qcom,ipq8072";

	aliases {
		serial0 = &blsp1_uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&blsp1_uart0 {
	status = "okay";
};

&spi_0 {
	status = "okay";
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	cs-gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0000000 { label = "0:sbl1";        reg = <0x0000000 0x00100000>; read-only; };
			partition@0100000 { label = "0:mibib";       reg = <0x0100000 0x00100000>; read-only; };
			partition@0200000 { label = "0:qsee";        reg = <0x0200000 0x00300000>; read-only; };
			partition@0500000 { label = "0:devcfg";      reg = <0x0500000 0x00080000>; read-only; };
			partition@0580000 { label = "0:rpm";        reg = <0x0580000 0x00080000>; read-only; };
			partition@0600000 { label = "0:cdt";        reg = <0x0600000 0x00080000>; read-only; };
			partition@0680000 { label = "0:appsblenv";  reg = <0x0680000 0x00080000>; read-only; };
			partition@0700000 { label = "0:appsbl";     reg = <0x0700000 0x00100000>; read-only; };
			partition@0800000 { label = "0:art";        reg = <0x0800000 0x00080000>; read-only; };
			partition@0880000 { label = "bdata";        reg = <0x0880000 0x00080000>; read-only; };
			partition@0900000 { label = "crash";        reg = <0x0900000 0x00080000>; };
			partition@0980000 { label = "crash_syslog";  reg = <0x0980000 0x00080000>; };
			
			// ✅ 【唯一正确】无重叠，匹配你的 mtd12
			partition@0a00000 { label = "rootfs";       reg = <0x0a00000 0x0EFE0000>; };
			
			// ✅ 【唯一正确】跟上一个分区完全衔接
			partition@f9e0000 { label = "rsvd0";        reg = <0x0f9e0000 0x00020000>; read-only; };
		};
	};
};
