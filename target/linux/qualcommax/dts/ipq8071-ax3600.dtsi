/dts-v1/;
#include "ipq8072.dtsi"
#include "ipq8072-hk-adc.dtsi"

/ {
	model = "Xiaomi AX3600";
	compatible = "xiaomi,ax3600", "qcom,ipq8072";

	aliases {
		serial0 = &blsp1_uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&blsp1_uart0 {
	status = "okay";
};

&spi_0 {
	status = "okay";
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	cs-gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x0000000 0x00100000>;
				read-only;
			};
			partition@100000 {
				label = "0:mibib";
				reg = <0x00100000 0x00100000>;
				read-only;
			};
			partition@200000 {
				label = "0:qsee";
				reg = <0x00200000 0x00300000>;
				read-only;
			};
			partition@500000 {
				label = "0:devcfg";
				reg = <0x00500000 0x00080000>;
				read-only;
			};
			partition@580000 {
				label = "0:rpm";
				reg = <0x00580000 0x00080000>;
				read-only;
			};
			partition@600000 {
				label = "0:cdt";
				reg = <0x00600000 0x00080000>;
				read-only;
			};
			partition@680000 {
				label = "0:appsblenv";
				reg = <0x00680000 0x00080000>;
				read-only;
			};
			partition@700000 {
				label = "0:appsbl";
				reg = <0x00700000 0x00100000>;
				read-only;
			};
			partition@800000 {
				label = "0:art";
				reg = <0x00800000 0x00080000>;
				read-only;
			};
			partition@880000 {
				label = "bdata";
				reg = <0x00880000 0x00080000>;
				read-only;
			};
			partition@900000 {
				label = "crash";
				reg = <0x00900000 0x00080000>;
			};
			partition@980000 {
				label = "crash_syslog";
				reg = <0x00980000 0x00080000>;
			};
			partition@a00000 {
				label = "rootfs";
				reg = <0x00a00000 0x0f000000>;
			};
			partition@fa00000 {
				label = "rsvd0";
				reg = <0x0fa00000 0x00080000>;
				read-only;
			};
		};
	};
};
