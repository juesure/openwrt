# ===================== 基础编译环境限定（核心修复） =====================
# 仅编译高通 Qualcommax IPQ807x 平台（Redmi AX6），彻底禁用联发科
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6=y
CONFIG_TARGET_mediatek=n
CONFIG_TARGET_mediatek_filogic=n
CONFIG_TARGET_armvirt=n
CONFIG_TARGET_ath79=n
CONFIG_TARGET_bcm27xx=n

# 架构限定（适配 Redmi AX6）
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq807x"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"

# ===================== 基础必备插件 =====================
# 系统基础工具
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_7z=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y

# SSH 增强（带 SFTP）
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_dropbearconvert=y

# 进程/日志管理
CONFIG_PACKAGE_top=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_logread=y
CONFIG_PACKAGE_logrotate=y

# ===================== APK 包管理支持（新增核心） =====================
# 1. APK 核心组件（必须）
CONFIG_PACKAGE_libapk=y          # APK 核心库（基础依赖）
CONFIG_PACKAGE_apk=y             # APK 命令行工具（apk add/remove 等）
# 2. APK 依赖的基础库（缺一不可）
CONFIG_PACKAGE_libcrypto=y       # OpenSSL 加密库
CONFIG_PACKAGE_libssl=y          # SSL 支持
CONFIG_PACKAGE_libz=y            # 压缩库
CONFIG_PACKAGE_libpthread=y      # 线程库
CONFIG_PACKAGE_librt=y           # 实时库
# 3. APK 网络/扩展支持（可选，提升可用性）
CONFIG_PACKAGE_ca-certificates=y # HTTPS 源证书验证（避免 apk update 报错）
CONFIG_PACKAGE_busybox-wget=y    # 备用下载工具（兼容 apk 下载）
CONFIG_PACKAGE_base-files=y      # /etc 配置文件支持（APK 源配置）
CONFIG_PACKAGE_busybox-ash=y     # Shell 环境（APK 脚本执行）
CONFIG_PACKAGE_busybox-mount=y   # 挂载工具（APK 安装时依赖）

# ===================== 网络实用插件 =====================
# 网络诊断工具
CONFIG_PACKAGE_ping=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iftop=y

# 网络加速/代理
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y  # 阿里云 DDNS
CONFIG_PACKAGE_ddns-scripts_dnspod=y  # 腾讯 DNSPod DDNS
CONFIG_PACKAGE_smartdns=y             # 智能 DNS 解析
CONFIG_PACKAGE_dnsmasq-full=y         # 完整 DNS 服务（替换默认精简版）
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y

# 网络共享（Samba）
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-libs=y

# ===================== LuCI 界面增强 =====================
# 基础 LuCI 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-fs=y
CONFIG_PACKAGE_luci-proto-pppoe=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# LuCI 主题（Argon 主题）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-argon-config=y

# LuCI 应用插件
CONFIG_PACKAGE_luci-app-ddns=y        # DDNS 管理界面
CONFIG_PACKAGE_luci-app-samba4=y      # Samba 管理界面
CONFIG_PACKAGE_luci-app-smartdns=y    # SmartDNS 管理界面
CONFIG_PACKAGE_luci-app-firewall=y    # 防火墙管理
CONFIG_PACKAGE_luci-app-upnp=y        # UPnP 自动端口映射
CONFIG_PACKAGE_luci-app-autoreboot=y  # 自动重启
CONFIG_PACKAGE_luci-app-filetransfer=y # 文件传输（上传/下载固件）
CONFIG_PACKAGE_luci-app-system=y      # 系统管理
CONFIG_PACKAGE_luci-app-network=y     # 网络管理

# ===================== Home Assistant 相关插件 =====================
# 1. Home Assistant 核心依赖（OpenWrt 端）
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
CONFIG_PACKAGE_python3-dev=y
CONFIG_PACKAGE_python3-setuptools=y
CONFIG_PACKAGE_python3-requests=y
CONFIG_PACKAGE_python3-urllib3=y
CONFIG_PACKAGE_python3-yaml=y
CONFIG_PACKAGE_python3-sqlite3=y
CONFIG_PACKAGE_python3-aiohttp=y      # HA 核心依赖
CONFIG_PACKAGE_python3-multidict=y
CONFIG_PACKAGE_python3-yarl=y

# 2. MQTT 服务（HA 设备通信）
CONFIG_PACKAGE_mosquitto=y            # MQTT 服务器
CONFIG_PACKAGE_luci-app-mosquitto=y   # MQTT 管理界面
CONFIG_PACKAGE_mosquitto-ssl=y        # MQTT SSL 支持

# 3. HA 设备发现（SSDP/UPnP）
CONFIG_PACKAGE_ssdp=y
CONFIG_PACKAGE_minidlna=y             # DLNA 服务（可选）
CONFIG_PACKAGE_luci-app-minidlna=y

# 4. HA 远程访问（可选）
CONFIG_PACKAGE_luci-app-frps=y        # FRP 内网穿透
CONFIG_PACKAGE_frpc=y

# ===================== 存储/驱动优化（适配 256M NAND Flash） =====================
# UBI/UBIFS 坏块管理（核心）
CONFIG_TARGET_ROOTFS_UBIFS=y
CONFIG_TARGET_ROOTFS_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096      # 坏块阈值优化
CONFIG_UBIFS_GC_PERIOD=100            # 垃圾回收周期优化

# 高通 WiFi 驱动（IPQ8071A 专用）
CONFIG_PACKAGE_ipq-wifi-redmi_ax6=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-ssdk-ipq807x=y
CONFIG_PACKAGE_kmod-qca-wifi=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=n
# 使用 IPQ8071 专用固件（修正：之前配置反了）
CONFIG_PACKAGE_ath11k-firmware-ipq8071=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=n
# NSS 固件（若需要，可选）
CONFIG_PACKAGE_qca-nss-firmware=y

# 彻底禁用所有联发科相关驱动/组件
CONFIG_PACKAGE_kmod-mt76=n
CONFIG_PACKAGE_kmod-mt7601u=n
CONFIG_PACKAGE_kmod-mt7603e=n
CONFIG_PACKAGE_kmod-mt7615e=n
CONFIG_PACKAGE_kmod-mt7620e=n
CONFIG_PACKAGE_kmod-mt7692=n
CONFIG_PACKAGE_kmod-mt7915e=n
CONFIG_PACKAGE_kmod-mt7921e=n
CONFIG_PACKAGE_firmware-mediatek=n
CONFIG_PACKAGE_mt7981-eeprom=n

# 禁用不必要的驱动（减少固件体积）
CONFIG_PACKAGE_kmod-rtl8812au=n
CONFIG_PACKAGE_kmod-rtl8821cu=n
CONFIG_PACKAGE_kmod-rtw88=n

# ===================== 固件编译优化 =====================
# 启用压缩（减少固件体积）
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_IMAGES_SQUASHFS_COMPRESSION_GZIP=y

# 禁用调试信息（减少体积）
CONFIG_DEBUG=n
CONFIG_KERNEL_DEBUG=n
CONFIG_KERNEL_DEBUG_FS=n

# 启用内核模块分离（可选）
CONFIG_PACKAGE_kmod=y
CONFIG_MODULES=y
CONFIG_MODULES_PACKAGES=y

# ===================== iStore 应用商店 =====================
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-store=y
CONFIG_PACKAGE_luci-i18n-store-zh-cn=y
CONFIG_PACKAGE_store-apps=y
