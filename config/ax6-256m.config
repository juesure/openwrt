# ===================== 基础必备插件 =====================
# 系统基础工具
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_7z=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y

# SSH 增强（带 SFTP）
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_dropbearconvert=y

# 进程/日志管理
CONFIG_PACKAGE_top=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_logread=y
CONFIG_PACKAGE_logrotate=y

# ===================== 网络实用插件 =====================
# 网络诊断工具
CONFIG_PACKAGE_ping=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iftop=y

# 网络加速/代理
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y  # 阿里云 DDNS
CONFIG_PACKAGE_ddns-scripts_dnspod=y  # 腾讯 DNSPod DDNS
CONFIG_PACKAGE_smartdns=y             # 智能 DNS 解析
CONFIG_PACKAGE_dnsmasq-full=y         # 完整 DNS 服务（替换默认精简版）
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y

# 网络共享（Samba）
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-libs=y

# ===================== LuCI 界面增强 =====================
# 基础 LuCI 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-fs=y
CONFIG_PACKAGE_luci-proto-pppoe=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# LuCI 主题（Argon 主题）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-argon-config=y

# LuCI 应用插件
CONFIG_PACKAGE_luci-app-ddns=y        # DDNS 管理界面
CONFIG_PACKAGE_luci-app-samba4=y      # Samba 管理界面
CONFIG_PACKAGE_luci-app-smartdns=y    # SmartDNS 管理界面
CONFIG_PACKAGE_luci-app-firewall=y    # 防火墙管理
CONFIG_PACKAGE_luci-app-upnp=y        # UPnP 自动端口映射
CONFIG_PACKAGE_luci-app-autoreboot=y  # 自动重启
CONFIG_PACKAGE_luci-app-filetransfer=y # 文件传输（上传/下载固件）
CONFIG_PACKAGE_luci-app-system=y      # 系统管理
CONFIG_PACKAGE_luci-app-network=y     # 网络管理

# ===================== Home Assistant 相关插件 =====================
# 1. Home Assistant 核心依赖（OpenWrt 端）
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
CONFIG_PACKAGE_python3-dev=y
CONFIG_PACKAGE_python3-setuptools=y
CONFIG_PACKAGE_python3-requests=y
CONFIG_PACKAGE_python3-urllib3=y
CONFIG_PACKAGE_python3-yaml=y
CONFIG_PACKAGE_python3-sqlite3=y
CONFIG_PACKAGE_python3-aiohttp=y      # HA 核心依赖
CONFIG_PACKAGE_python3-multidict=y
CONFIG_PACKAGE_python3-yarl=y

# 2. MQTT 服务（HA 设备通信）
CONFIG_PACKAGE_mosquitto=y            # MQTT 服务器
CONFIG_PACKAGE_luci-app-mosquitto=y   # MQTT 管理界面
CONFIG_PACKAGE_mosquitto-ssl=y        # MQTT SSL 支持

# 3. HA 设备发现（SSDP/UPnP）
CONFIG_PACKAGE_ssdp=y
CONFIG_PACKAGE_minidlna=y             # DLNA 服务（可选）
CONFIG_PACKAGE_luci-app-minidlna=y

# 4. HA 远程访问（可选）
CONFIG_PACKAGE_luci-app-frps=y        # FRP 内网穿透
CONFIG_PACKAGE_frpc=y

# ===================== 其他优化配置 =====================
# 启用 UBIFS 坏块管理（适配 256M NAND）
CONFIG_TARGET_ROOTFS_UBIFS=y
CONFIG_TARGET_ROOTFS_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_MTD_UBI=y

# 禁用不必要的驱动（减少固件体积）
CONFIG_PACKAGE_kmod-mt76=n            # 禁用联发科 WiFi 驱动（Redmi AX6 用不到）
CONFIG_PACKAGE_kmod-rtl8812au=n       # 禁用 RTL8812AU 无线驱动
