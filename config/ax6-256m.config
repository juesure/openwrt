# ==============================
# 必选基础（保证编译成功）
# ==============================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6=y
CONFIG_DEVEL=y
CONFIG_NONSHARED_LIBS=y
CONFIG_MTD_UBI_FASTMAP=y
CONFIG_MTD_UBI_BLOCK=y
CONFIG_TARGET_ROOTFS_UBIFS=y
CONFIG_TARGET_ROOTFS_UBI=y
CONFIG_MTD_UBI=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_ALL_PROFILES=n

# ==============================
# 稳定版 LuCI（不冲突、必过）
# ==============================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# ==============================
# iStore 商店（稳定版）
# ==============================
CONFIG_PACKAGE_luci-app-istore=y
CONFIG_PACKAGE_luci-lib-ipkg=y

# ==============================
# Docker （稳定不炸编译）
# ==============================
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y

# ==============================
# WiFi 固件（确保完整）
# ==============================
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y

# ==============================
# 国内清华源（默认生效）
# ==============================
CONFIG_OPKG_MIRROR_URL="https://mirrors.tuna.tsinghua.edu.cn/openwrt"
