# ===================== 基础编译环境限定 =====================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_mediatek=n
CONFIG_TARGET_mediatek_filogic=n
CONFIG_TARGET_armvirt=n
CONFIG_TARGET_ath79=n
CONFIG_TARGET_bcm27xx=n

CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq807x"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"

# ===================== UBI/UBIFS 配置 =====================
CONFIG_TARGET_ROOTFS_UBIFS=y
CONFIG_TARGET_ROOTFS_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096
CONFIG_UBIFS_GC_PERIOD=100
CONFIG_MTD_UBI_FASTMAP=y
CONFIG_MTD_UBI_BLOCK=y
CONFIG_MTD_NAND=y
CONFIG_MTD_NAND_ECC=y
CONFIG_MTD_NAND_ECC_SW_BCH=y

CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_mtd-utils-mkfs-ubifs=y
CONFIG_PACKAGE_mtd-utils-ubi-utils=y
CONFIG_PACKAGE_nand-utils=y

# ===================== WiFi 驱动 (IPQ8071A 专用) =====================
# AHB 总线驱动
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=n

# 同时安装两个固件包确保文件完整
CONFIG_PACKAGE_ath11k-firmware-ipq8071=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_PACKAGE_ath11k-firmware-ipq8071-ct=n

# 高通 NSS 加速
CONFIG_PACKAGE_kmod-qca-wifi=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-qca-ssdk-ipq807x=y

# WiFi 校准数据
CONFIG_PACKAGE_ipq-wifi-redmi_ax6=y

# 调试选项
CONFIG_ATH11K_DEBUG=n

# 禁用联发科驱动
CONFIG_PACKAGE_kmod-mt76=n
CONFIG_PACKAGE_kmod-mt7601u=n
CONFIG_PACKAGE_kmod-mt7603e=n
CONFIG_PACKAGE_kmod-mt7615e=n
CONFIG_PACKAGE_kmod-mt7620e=n
CONFIG_PACKAGE_kmod-mt7692=n
CONFIG_PACKAGE_kmod-mt7915e=n
CONFIG_PACKAGE_kmod-mt7921e=n
CONFIG_PACKAGE_firmware-mediatek=n

# ===================== LuCI Web 界面 =====================
# Web 服务器
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_uhttpd-mod-tls=y

# LuCI 核心
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-firewall=y

# LuCI 协议支持
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# LuCI 主题
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-argon-config=y

# LuCI 应用
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-upnp=y

# 中文语言包
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# 默认语言
CONFIG_LUCI_LANG="zh-cn"

# ===================== 基础系统工具 =====================
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_7z=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_dropbearconvert=y
CONFIG_PACKAGE_top=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_logread=y
CONFIG_PACKAGE_logrotate=y

# ===================== 网络工具 =====================
CONFIG_PACKAGE_ping=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_ddns-scripts_dnspod=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y

# ===================== 编译优化 =====================
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_IMAGES_SQUASHFS_COMPRESSION_GZIP=y
CONFIG_DEBUG=n
CONFIG_KERNEL_DEBUG=n
CONFIG_KERNEL_DEBUG_FS=n
CONFIG_PACKAGE_kmod=y
CONFIG_MODULES=y
